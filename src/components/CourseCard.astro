---
import Button from "./Button.astro";
import type { Course } from "../types";
import { SITE_CONFIG } from "../config/site";

export interface Props {
  course: Course;
}

const { course } = Astro.props;

const formatPrice = (price: number) =>
  new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(price);

const hasPrice = course.price !== undefined;
const courseLink = course.link || null;
---

<div class="course-card reveal">
  {courseLink ? (
    <a href={courseLink} target="_blank" rel="noopener noreferrer" class="card-image-link">
      <div class="card-image img-zoom">
        <img
          src={course.cover}
          alt={course.title}
          loading="lazy"
          width="600"
          height="400"
        />
        <div class="overlay">
          <div class="quick-info">
            <span class="info-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {course.duration}
            </span>
            <span class="info-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
              {course.lessons} lecciones
            </span>
          </div>
        </div>
      </div>
    </a>
  ) : (
    <div class="card-image img-zoom">
      <img
        src={course.cover}
        alt={course.title}
        loading="lazy"
        width="600"
        height="400"
      />
      <div class="overlay">
        <div class="quick-info">
          <span class="info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            {course.duration}
          </span>
          <span class="info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
            {course.lessons} lecciones
          </span>
        </div>
      </div>
    </div>
  )}
  <div class="card-body">
    <h3 class="title">{course.title}</h3>
    <p class="description">{course.description}</p>
    {course.nota && <p class="nota">{course.nota}</p>}
    <div class="card-footer">
      <div class="card-footer-left">
        {hasPrice && <span class="price">{formatPrice(course.price!)}</span>}
        {courseLink && (
          <a href={courseLink} target="_blank" rel="noopener noreferrer" class="btn-comprar">
            Comprar
          </a>
        )}
      </div>
      <Button
        href={`https://wa.me/${SITE_CONFIG.whatsappPhone}?text=${encodeURIComponent(course.whatsapp || "")}`}
        variant="primary"
        size="sm"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 4px; vertical-align: middle;">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Más info
      </Button>
    </div>
  </div>
</div>

<style>
  .course-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .course-card:hover .card-image img {
    transform: scale(1.08);
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md);
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
  }

  .quick-info {
    display: flex;
    gap: var(--space-md);
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    color: var(--color-white);
    font-weight: 500;
  }

  .card-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .title {
    font-family: var(--font-primary);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-text);
  }

  .description {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.7;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border-light);
    gap: var(--space-sm);
  }

  .card-footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nota {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-style: italic;
    line-height: 1.5;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    margin: 0;
  }

  .price {
    font-family: var(--font-secondary);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-primary);
  }

  .btn-comprar {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-base);
    white-space: nowrap;
  }

  .btn-comprar:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 480px) {
    .card-body {
      padding: var(--space-md);
    }
    .title {
      font-size: var(--text-xl);
    }
    .card-footer {
      flex-wrap: wrap;
    }
  }
</style>