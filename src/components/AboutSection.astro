---
import Button from "./Button.astro";
---

<section id="sobre-harmony" class="about-section section section-anchor">
  <div class="container">
    <div class="about-grid">
      <div class="about-image reveal-left">
        <div class="image-wrapper">
          <img
            src="/images/about/about-harmony.jpg"
            alt="Harmony Candle - Proceso artesanal"
            loading="lazy"
            width="600"
            height="750"
          />
          <div class="floating-badge">
            <span class="badge-number">2020</span>
            <span class="badge-text">Desde</span>
          </div>
        </div>
      </div>

      <div class="about-content reveal-right">
        <span class="about-label">Nuestra historia</span>
        <h2 class="about-title">Hecho a mano, con corazón</h2>

        <div class="about-text">
          <p>
            Harmony Candle nació en 2020 de la pasión por crear espacios llenos de
            armonía y bienestar. Lo que comenzó como un pequeño proyecto artesanal
            se ha convertido en una marca dedicada a transformar hogares con
            productos naturales y sostenibles.
          </p>
          <p>
            Cada vela, cada ramo y cada accesorio es elaborado cuidadosamente a mano,
            seleccionando los mejores materiales naturales para garantizar la más alta
            calidad. Creemos en el poder de los pequeños detalles para crear grandes
            momentos de paz y conexión.
          </p>
        </div>

        <div class="values">
          <div class="value-item">
            <div class="value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/>
              </svg>
            </div>
            <div>
              <h4>100% Natural</h4>
              <p>Materiales sostenibles y ecológicos</p>
            </div>
          </div>

          <div class="value-item">
            <div class="value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
              </svg>
            </div>
            <div>
              <h4>Artesanal</h4>
              <p>Cada pieza es única y hecha a mano</p>
            </div>
          </div>

          <div class="value-item">
            <div class="value-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/>
              </svg>
            </div>
            <div>
              <h4>Hecho en Colombia</h4>
              <p>Apoyando el talento local</p>
            </div>
          </div>
        </div>

        <div class="about-actions">
          <Button href="#contacto" variant="primary" size="md">
            Contáctanos
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--color-bg);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .image-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
  }

  .floating-badge {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-lg);
    background: var(--color-white);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .badge-number {
    display: block;
    font-family: var(--font-primary);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1;
  }

  .badge-text {
    font-family: var(--font-secondary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
  }

  .about-label {
    display: inline-block;
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .about-title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .about-text p {
    font-size: var(--text-base);
    color: var(--color-text-light);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .values {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
  }

  .value-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    background: var(--color-accent-light);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .value-item h4 {
    font-family: var(--font-primary);
    font-size: var(--text-lg);
    font-weight: 500;
    margin-bottom: 2px;
    color: var(--color-text);
  }

  .value-item p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .about-title {
      font-size: var(--text-3xl);
    }

    .floating-badge {
      bottom: var(--space-md);
      left: var(--space-md);
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>