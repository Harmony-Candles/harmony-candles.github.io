---
export interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  className?: string;
}

const { label, title, subtitle, centered = true, className = "" } = Astro.props;
---

<div class={`section-header ${centered ? "centered" : ""} ${className}`}>
  {label && <span class="section-label reveal">{label}</span>}
  <h2 class="section-title reveal">{title}</h2>
  {subtitle && <p class="section-subtitle reveal">{subtitle}</p>}
</div>

<style>
  .section-header {
    margin-bottom: var(--space-2xl);
  }

  .centered {
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    max-width: 600px;
    line-height: 1.7;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: var(--text-3xl);
    }
  }
</style>