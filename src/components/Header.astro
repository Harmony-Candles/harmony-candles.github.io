---
import type { NavItem } from "../types";

export interface Props {
  navItems: NavItem[];
  transparent?: boolean;
  categories?: { slug: string; name: string; href: string }[];
}

const { navItems, transparent = true, categories = [] } = Astro.props;
---

  <header class="navbar" id="navbar" data-transparent={transparent ? "true" : "false"}>
  <nav class="nav-container">
    <a href="/" class="nav-logo" aria-label="Harmony Candle - Inicio">
      <img
        src="/brand/harmony-logo.png"
        alt="Harmony Candle"
        width="180"
        height="50"
        class="logo"
      />
    </a>

    <button class="mobile-toggle" id="mobileToggle" aria-label="Menú de navegación">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <li>
          {item.label === "Catálogo" && categories.length > 0 ? (
            <div class="nav-dropdown">
              <a href={item.href} class="nav-link hover-underline">
                {item.label}
                <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </a>
              <div class="submenu">
                <a href={item.href} class="submenu-item submenu-all">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                  </svg>
                  Ver todo el catálogo
                </a>
                <div class="submenu-grid">
                  {categories.map((cat) => (
                    <a href={cat.href} class="submenu-item">
                      <span class="submenu-dot"></span>
                      {cat.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="nav-link hover-underline">
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const mobileToggle = document.getElementById("mobileToggle");
  const navLinks = document.getElementById("navLinks");
  const navLinksAnchors = navLinks?.querySelectorAll("a");

  mobileToggle?.addEventListener("click", () => {
    mobileToggle.classList.toggle("active");
    navLinks?.classList.toggle("open");
    document.body.classList.toggle("no-scroll");
  });

  navLinksAnchors?.forEach((link) => {
    link.addEventListener("click", () => {
      mobileToggle?.classList.remove("active");
      navLinks?.classList.remove("open");
      document.body.classList.remove("no-scroll");
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-sticky);
    height: var(--navbar-height);
    display: flex;
    align-items: center;
    transition: all var(--transition-base);
    background: transparent;
  }

  .navbar.scrolled {
    height: var(--navbar-height-scrolled);
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.06);
  }

  .nav-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    transition: transform var(--transition-base);
  }

  .navbar.scrolled .nav-logo {
    transform: scale(0.9);
  }

  .logo {
    height: clamp(35px, 5vw, 50px);
    width: auto;
    object-fit: contain;
  }

  /* Logo white when navbar is transparent (over hero) */
  .navbar[data-transparent="true"]:not(.scrolled) .logo {
    filter: brightness(0) invert(1);
  }

  /* Logo: non-transparent mode or scrolled — always dark */
  .navbar[data-transparent="false"] .logo,
  .navbar.scrolled .logo {
    filter: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
    position: relative;
    padding: 0.25rem 0;
    transition: color var(--transition-fast);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .navbar[data-transparent="true"]:not(.scrolled) .nav-link {
    color: var(--color-white);
  }

  .navbar[data-transparent="false"] .nav-link,
  .navbar.scrolled .nav-link {
    color: var(--color-text);
  }

  .nav-link:hover {
    color: var(--color-primary) !important;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* ---- Submenu / Dropdown ---- */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 360px;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1), 0 2px 8px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0.75rem 0;
    z-index: var(--z-overlay);
  }

  .nav-dropdown:hover .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(6px);
  }

  .submenu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem;
    padding: 0 0.5rem;
  }

  .submenu-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    font-family: var(--font-secondary);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
  }

  .submenu-item:hover {
    background: var(--color-bg-alt);
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .submenu-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0.5;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .submenu-item:hover .submenu-dot {
    opacity: 1;
  }

  .submenu-all {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    margin: 0 0.5rem 0.4rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.15s ease;
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: 0.7rem;
  }

  .submenu-all:hover {
    background: rgba(196, 154, 108, 0.08);
    color: var(--color-primary-dark);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: var(--z-overlay);
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  .navbar[data-transparent="true"]:not(.scrolled) .hamburger-line {
    background-color: var(--color-white);
  }

  .navbar[data-transparent="false"] .hamburger-line {
    background-color: var(--color-text);
  }

  .mobile-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(250, 248, 245, 0.98);
      backdrop-filter: blur(20px);
      flex-direction: column;
      justify-content: center;
      gap: var(--space-lg);
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-base);
      z-index: calc(var(--z-overlay) - 1);
    }

    .nav-links.open {
      opacity: 1;
      visibility: visible;
    }

    .nav-link {
      font-size: var(--text-xl);
      color: var(--color-text) !important;
    }

    /* In mobile, show submenu inline */
    .submenu {
      position: static;
      transform: none;
      opacity: 1;
      visibility: visible;
      box-shadow: none;
      border: none;
      background: transparent;
      backdrop-filter: none;
      padding: 0.25rem 0 0 0;
      width: auto;
    }

    .submenu-grid {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
    }

    .submenu-item {
      padding: 0.4rem 0.5rem;
      font-size: var(--text-base);
    }

    .submenu-all {
      display: none;
    }

    .nav-dropdown {
      flex-direction: column;
      align-items: flex-start;
    }

    .dropdown-chevron {
      display: none;
    }
  }
</style>